[
  {"name": "power", "source": "begin R := 1; while Y > 0 do begin R := R * X; Y := Y - 1 end end",
   "vars": {"X": 2, "Y": 3},
   "expect": {"status": "ok", "state": {"X": 2, "Y": 0, "R": 8},
              "term": "AS^R(1̄) • WH(S^2(gr, Y⇒, 0̄), AS^R(S^2(mult, R⇒, X⇒)) • AS^Y(S^2(sub, Y⇒, 1̄)))"}},
  {"name": "gcd", "source": "while not (A = B) do if A > B then A := A - B else B := B - A",
   "vars": {"A": 12, "B": 18}, "expect": {"status": "ok", "state": {"A": 6, "B": 6}}},
  {"name": "skip", "source": "skip", "expect": {"status": "ok", "state": {}, "term": "ID"}},
  {"name": "if-else", "source": "if x > y then m := x else m := y", "vars": {"x": 1, "y": 5},
   "expect": {"status": "ok", "state": {"x": 1, "y": 5, "m": 5}, "term": "IF(S^2(gr, x⇒, y⇒), AS^m(x⇒), AS^m(y⇒))"}},
  {"name": "if-without-else", "source": "if x > 0 then y := 1", "vars": {"x": 0},
   "expect": {"status": "ok", "state": {"x": 0}}},
  {"name": "nested-blocks", "source": "begin begin a := 1 end; b := a + 1 end",
   "expect": {"status": "ok", "state": {"a": 1, "b": 2}}},
  {"name": "precedence", "source": "x := 2 + 3 * 4", "expect": {"status": "ok", "state": {"x": 14}}},
  {"name": "unary-minus", "source": "x := -3 + 5", "expect": {"status": "ok", "state": {"x": 2}}},
  {"name": "floor-division", "source": "x := 0 - 7; y := x / 2; z := x % 2",
   "expect": {"status": "ok", "state": {"x": -7, "y": -4, "z": 1}}},
  {"name": "ast-assign", "source": "x := 1",
   "expect": {"status": "ok", "ast": {"type": "Assign", "name": "x", "expr": {"type": "Num", "value": 1}}}},
  {"name": "syntax-missing-end", "source": "begin x := 1",
   "expect": {"status": "syntax_error", "error": {"code": "syntax-error", "line": 1, "col": 13}}},
  {"name": "syntax-wrong-assign", "source": "x = 1",
   "expect": {"status": "syntax_error", "error": {"line": 1, "col": 3}}},
  {"name": "syntax-bad-char", "source": "x := 1 $ 2",
   "expect": {"status": "syntax_error", "error": {"line": 1, "col": 8}}},
  {"name": "runtime-undefined", "source": "y := x + 1",
   "expect": {"status": "runtime_error", "error": {"code": "undefined-variable", "line": 1, "col": 6}}},
  {"name": "runtime-div-zero", "source": "x := 1 / 0",
   "expect": {"status": "runtime_error", "error": {"code": "division-by-zero"}}},
  {"name": "runtime-step-limit", "source": "while true do skip",
   "expect": {"status": "runtime_error", "error": {"code": "step-limit"}}}
]